{
  "name": "streamdeck-beamer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stream-Deck-Plugin zur Steuerung eines Acer-Beamers mit zustandsabhaengiger Beschriftung",
  "scripts": {
    "build": "rollup -c",
    "test": "node --test \"test/*.test.ts\"",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart local.beamer.control\"",
    "typecheck": "tsc",
    "link": "streamdeck link local.beamer.control.sdPlugin",
    "restart": "streamdeck restart local.beamer.control"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.4",
    "rollup": "^4.64.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
