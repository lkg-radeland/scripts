{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Beamer",
  "Version": "1.0.0.0",
  "Author": "Andreas",
  "UUID": "local.beamer.control",
  "Icon": "imgs/plugin-icon",
  "Description": "Schaltet einen Acer-Beamer über das Netzwerk und zeigt seinen Zustand auf der Taste an - einschließlich der Abkühlphase.",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "24"
  },
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Actions": [
    {
      "UUID": "local.beamer.control.power",
      "Name": "Beamer Power",
      "Icon": "imgs/action-icon",
      "Tooltip": "Beamer ein- und ausschalten. Die Beschriftung zeigt den aktuellen Zustand.",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/beamer-power.html",
      "States": [
        {
          "Image": "imgs/key-off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/key-on",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}
